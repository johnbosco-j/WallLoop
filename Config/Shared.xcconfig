// Shared build settings for every configuration.
//
// By default the app is signed ad hoc ("Sign to Run Locally") so it builds on any
// Mac without an Apple Developer account. To sign with your team, create
// Config/Local.xcconfig (gitignored) containing:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_STYLE = Automatic
//   CODE_SIGN_IDENTITY = Apple Development

CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =

// Sparkle auto-updates. Fill these in once before your first release (see README,
// "Releasing"). While APPCAST_URL is still the placeholder, the updater stays off
// and "Check for Updates…" is disabled, so development builds never hit the network.
//
// The double slash in a URL would start an xcconfig comment, so it is written as
// https:/$()/ — Xcode expands $() to nothing.
APPCAST_URL = https:/$()/example.com/wallloop/appcast.xml
SPARKLE_PUBLIC_KEY = REPLACE_WITH_SPARKLE_PUBLIC_ED_KEY

#include? "Local.xcconfig"
